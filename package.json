{
  "name": "@superinstance/swarm-orchestration",
  "version": "1.0.0",
  "description": "Multi-agent orchestration system for coordinating AI swarms",
  "private": true,
  "license": "MIT",
  "author": "SuperInstance",
  "homepage": "https://github.com/SuperInstance/SwarmOrchestration#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/SuperInstance/SwarmOrchestration.git"
  },
  "bugs": {
    "url": "https://github.com/SuperInstance/SwarmOrchestration/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "swarm-orchestrator": "dist/orchestrator/index.js",
    "swarm-worker": "dist/worker/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/orchestrator/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "tsup",
    "start": "node dist/orchestrator/index.js",
    "start:worker": "node dist/worker/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "tsup": "^8.4.0",
    "typescript": "^5",
    "vitest": "^3.0.5",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9",
    "tsconfig-paths": "^4.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [
    "superinstance",
    "swarm",
    "orchestration",
    "multi-agent",
    "distributed",
    "workers",
    "task-queue",
    "microservices"
  ]
}

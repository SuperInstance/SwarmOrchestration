# Swarm Orchestration Configuration

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Task Queue
QUEUE_PROVIDER=redis
QUEUE_MAX_RETRY=3
QUEUE_TIMEOUT=30000
QUEUE_CONCURRENCY=10

# Agents
AGENT_HEARTBEAT_INTERVAL=5000
AGENT_TIMEOUT=30000
MAX_CONCURRENT_TASKS=10
AGENT_SHUTDOWN_TIMEOUT=10000

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# WebSocket
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CONNECTIONS=1000

# Clustering
CLUSTER_MODE=false
CLUSTER_WORKERS=0
